{
  "description": "Daily at 6am ET, prepares the generator run queue for the day and logs a readiness summary.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 6 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_morning_queue_prep",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "log_prep": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "logFactoryEvent",
            "args": {
              "event_type": "morning_queue_prep",
              "entity_type": "GeneratorRun",
              "entity_id": "system",
              "severity": "info",
              "workflow_name": "Daily Morning Queue Prep",
              "payload": {
                "check": "queue_readiness"
              }
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Log queue prep",
            "description": "Daily 6am queue readiness"
          }
        }
      }
    ]
  },
  "name": "Daily Morning Queue Prep"
}