{
  "name": "On Run Step Skipped",
  "description": "When a RunStep transitions to skipped status, logs an audit event.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "RunStep",
      "events": [
        "update"
      ]
    },
    "condition": "${ .trigger.data.status == \"skipped\" and .trigger.old_data.status != \"skipped\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "on_run_step_skipped",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "log_skipped": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "logFactoryEvent",
            "args": {
              "event_type": "run_step_skipped",
              "entity_type": "RunStep",
              "entity_id": "${ .trigger.entity_id }",
              "severity": "info",
              "workflow_name": "On Run Step Skipped",
              "payload": {
                "run_id": "${ .trigger.data.run_id }",
                "step_key": "${ .trigger.data.step_key }"
              }
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Log step skipped",
            "description": "Audit on step skipped"
          }
        }
      }
    ]
  }
}