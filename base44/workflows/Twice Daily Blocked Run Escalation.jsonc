{
  "description": "Twice daily, escalates generator runs stuck in BLOCKED status and logs a critical event.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8,20 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "twice_daily_blocked_escalation",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "log_escalation": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "logFactoryEvent",
            "args": {
              "event_type": "blocked_run_escalation",
              "entity_type": "GeneratorRun",
              "entity_id": "system",
              "severity": "critical",
              "workflow_name": "Twice Daily Blocked Run Escalation",
              "payload": {
                "check": "blocked_runs"
              }
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Log escalation",
            "description": "Twice daily blocked run escalation"
          }
        }
      }
    ]
  },
  "name": "Twice Daily Blocked Run Escalation"
}