{
  "description": "Every 6 hours, checks adapter secret references for potential expiry and logs a warning.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "45 */6 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "six_hour_credential_expiry",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "log_expiry": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "logFactoryEvent",
            "args": {
              "event_type": "credential_expiry_check",
              "entity_type": "AdapterDefinition",
              "entity_id": "system",
              "severity": "warn",
              "workflow_name": "Six-hour Credential Expiry Check",
              "payload": {
                "check": "secret_expiry"
              }
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Log credential check",
            "description": "6-hour credential expiry scan"
          }
        }
      }
    ]
  },
  "name": "Six-hour Credential Expiry Check"
}