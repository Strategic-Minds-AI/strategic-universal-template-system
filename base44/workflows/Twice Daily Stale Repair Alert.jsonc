{
  "description": "Twice daily, alerts on repair tasks open for more than 24 hours.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 7,19 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "twice_daily_stale_repair",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "log_alert": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "logFactoryEvent",
            "args": {
              "event_type": "stale_repair_alert",
              "entity_type": "RepairTask",
              "entity_id": "system",
              "severity": "warn",
              "workflow_name": "Twice Daily Stale Repair Alert",
              "payload": {
                "check": "stale_repairs",
                "max_age_hours": 24
              }
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Log stale repair alert",
            "description": "Twice daily stale repair scan"
          }
        }
      }
    ]
  },
  "name": "Twice Daily Stale Repair Alert"
}