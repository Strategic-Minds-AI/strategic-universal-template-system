{
  "name": "On Template Pack Deprecated",
  "description": "When a TemplatePack transitions to deprecated status, logs a warning audit event.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "TemplatePack",
      "events": [
        "update"
      ]
    },
    "condition": "${ .trigger.data.status == \"deprecated\" and .trigger.old_data.status != \"deprecated\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "on_template_pack_deprecated",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "log_deprecated": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "logFactoryEvent",
            "args": {
              "event_type": "template_pack_deprecated",
              "entity_type": "TemplatePack",
              "entity_id": "${ .trigger.entity_id }",
              "severity": "warn",
              "workflow_name": "On Template Pack Deprecated",
              "payload": {
                "template_key": "${ .trigger.data.template_key }",
                "version": "${ .trigger.data.version }"
              }
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Log pack deprecated",
            "description": "Warning audit on template pack deprecated"
          }
        }
      }
    ]
  }
}