{
  "name": "On Validation Failure",
  "description": "When a RunValidation record with FAIL status is created, logs a critical audit event.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "RunValidation",
      "events": [
        "create"
      ]
    },
    "condition": "${ .trigger.data.status == \"FAIL\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "on_validation_failure",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "log_failure": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "logFactoryEvent",
            "args": {
              "event_type": "validation_failed",
              "entity_type": "RunValidation",
              "entity_id": "${ .trigger.entity_id }",
              "severity": "error",
              "workflow_name": "On Validation Failure",
              "payload": {
                "run_id": "${ .trigger.data.run_id }",
                "validator_layer": "${ .trigger.data.validator_layer }",
                "validator_id": "${ .trigger.data.validator_id }"
              }
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Log failure",
            "description": "Error on validation failure"
          }
        }
      }
    ]
  }
}