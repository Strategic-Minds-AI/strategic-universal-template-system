{
  "name": "On Provisioning Plan Executing",
  "description": "When a ProvisioningPlan transitions to executing status, logs an audit event.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "ProvisioningPlan",
      "events": [
        "update"
      ]
    },
    "condition": "${ .trigger.data.status == \"executing\" and .trigger.old_data.status != \"executing\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "on_provisioning_plan_executing",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "log_executing": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "logFactoryEvent",
            "args": {
              "event_type": "provisioning_plan_executing",
              "entity_type": "ProvisioningPlan",
              "entity_id": "${ .trigger.entity_id }",
              "severity": "info",
              "workflow_name": "On Provisioning Plan Executing",
              "payload": {
                "project_id": "${ .trigger.data.project_id }",
                "template_id": "${ .trigger.data.template_id }"
              }
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Log plan executing",
            "description": "Audit on plan execution started"
          }
        }
      }
    ]
  }
}