{
  "description": "Every 4 hours, rotates audit event summaries and logs a checkpoint for archival tracking.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 */4 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "quarterly_audit_rotation",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "log_rotation": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "logFactoryEvent",
            "args": {
              "event_type": "audit_event_rotation",
              "entity_type": "AuditEvent",
              "entity_id": "system",
              "severity": "info",
              "workflow_name": "Quarterly Audit Event Rotation",
              "payload": {
                "check": "audit_checkpoint",
                "window_hours": 4
              }
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Log rotation",
            "description": "4-hour audit rotation checkpoint"
          }
        }
      }
    ]
  },
  "name": "Quarterly Audit Event Rotation"
}