{
  "description": "Every Tuesday at 9am ET, checks template packs for needed updates and logs a refresh summary.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * 2",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "weekly_tuesday_template_refresh",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "log_refresh": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "logFactoryEvent",
            "args": {
              "event_type": "weekly_template_refresh",
              "entity_type": "TemplatePack",
              "entity_id": "system",
              "severity": "info",
              "workflow_name": "Weekly Tuesday Template Refresh",
              "payload": {
                "check": "pack_updates_needed"
              }
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Log template refresh",
            "description": "Weekly Tuesday template refresh"
          }
        }
      }
    ]
  },
  "name": "Weekly Tuesday Template Refresh"
}