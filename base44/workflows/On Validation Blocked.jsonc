{
  "name": "On Validation Blocked",
  "description": "When a RunValidation transitions to BLOCKED status, logs a warning audit event.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "RunValidation",
      "events": [
        "update"
      ]
    },
    "condition": "${ .trigger.data.status == \"BLOCKED\" and .trigger.old_data.status != \"BLOCKED\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "on_validation_blocked",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "log_blocked": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "logFactoryEvent",
            "args": {
              "event_type": "validation_blocked",
              "entity_type": "RunValidation",
              "entity_id": "${ .trigger.entity_id }",
              "severity": "warn",
              "workflow_name": "On Validation Blocked",
              "payload": {
                "validator_layer": "${ .trigger.data.validator_layer }",
                "validator_id": "${ .trigger.data.validator_id }"
              }
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Log validation blocked",
            "description": "Warning audit on validation blocked"
          }
        }
      }
    ]
  }
}