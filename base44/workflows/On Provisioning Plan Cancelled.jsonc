{
  "name": "On Provisioning Plan Cancelled",
  "description": "When a ProvisioningPlan transitions to cancelled status, logs a warning audit event.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "ProvisioningPlan",
      "events": [
        "update"
      ]
    },
    "condition": "${ .trigger.data.status == \"cancelled\" and .trigger.old_data.status != \"cancelled\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "on_provisioning_plan_cancelled",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "log_cancelled": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "logFactoryEvent",
            "args": {
              "event_type": "provisioning_plan_cancelled",
              "entity_type": "ProvisioningPlan",
              "entity_id": "${ .trigger.entity_id }",
              "severity": "warn",
              "workflow_name": "On Provisioning Plan Cancelled",
              "payload": {
                "project_id": "${ .trigger.data.project_id }",
                "template_id": "${ .trigger.data.template_id }"
              }
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Log plan cancelled",
            "description": "Warning audit on plan cancelled"
          }
        }
      }
    ]
  }
}