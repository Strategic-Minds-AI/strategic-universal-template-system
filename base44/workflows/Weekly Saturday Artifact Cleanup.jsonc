{
  "description": "Every Saturday at 2am ET, identifies orphaned or stale artifacts and logs a cleanup summary.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 2 * * 6",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "weekly_saturday_artifact_cleanup",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "log_cleanup": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "logFactoryEvent",
            "args": {
              "event_type": "weekly_artifact_cleanup",
              "entity_type": "Artifact",
              "entity_id": "system",
              "severity": "info",
              "workflow_name": "Weekly Saturday Artifact Cleanup",
              "payload": {
                "check": "orphaned_artifacts"
              }
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Log artifact cleanup",
            "description": "Weekly Saturday artifact cleanup"
          }
        }
      }
    ]
  },
  "name": "Weekly Saturday Artifact Cleanup"
}