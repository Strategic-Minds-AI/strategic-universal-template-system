{
  "name": "On Approval Expired",
  "description": "When an Approval transitions to expired status, logs a warning audit event.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "Approval",
      "events": [
        "update"
      ]
    },
    "condition": "${ .trigger.data.status == \"expired\" and .trigger.old_data.status != \"expired\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "on_approval_expired",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "log_expired": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "logFactoryEvent",
            "args": {
              "event_type": "approval_expired",
              "entity_type": "Approval",
              "entity_id": "${ .trigger.entity_id }",
              "severity": "warn",
              "workflow_name": "On Approval Expired",
              "payload": {
                "run_id": "${ .trigger.data.run_id }",
                "action_key": "${ .trigger.data.action_key }"
              }
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Log approval expired",
            "description": "Warning audit on approval expired"
          }
        }
      }
    ]
  }
}