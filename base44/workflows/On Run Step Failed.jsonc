{
  "name": "On Run Step Failed",
  "description": "When a RunStep transitions to failed status, logs an error audit event.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "RunStep",
      "events": [
        "update"
      ]
    },
    "condition": "${ .trigger.data.status == \"failed\" and .trigger.old_data.status != \"failed\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "on_run_step_failed",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "log_failed": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "logFactoryEvent",
            "args": {
              "event_type": "run_step_failed",
              "entity_type": "RunStep",
              "entity_id": "${ .trigger.entity_id }",
              "severity": "error",
              "workflow_name": "On Run Step Failed",
              "payload": {
                "run_id": "${ .trigger.data.run_id }",
                "step_key": "${ .trigger.data.step_key }",
                "error": "${ .trigger.data.error }"
              }
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Log step failed",
            "description": "Error audit on step failed"
          }
        }
      }
    ]
  }
}