{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "app_user_auth",
      "events": [
        "login"
      ]
    }
  },
  "description": "When a user logs in, logs an audit event for session tracking.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "on_user_login",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "log_login": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "logFactoryEvent",
            "args": {
              "event_type": "user_login",
              "entity_type": "User",
              "entity_id": "${ .trigger.user_id }",
              "severity": "info",
              "workflow_name": "On User Login",
              "payload": {
                "email": "${ .trigger.email }",
                "auth_method": "${ .trigger.auth_method }"
              }
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Log login",
            "description": "Audit on user login"
          }
        }
      }
    ]
  },
  "name": "On User Login"
}