{
  "name": "On Generator Definition Updated",
  "description": "When a GeneratorDefinition is updated, logs an audit event tracking the change.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "GeneratorDefinition",
      "events": [
        "update"
      ]
    },
    "condition": null
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "on_generator_definition_updated",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "log_update": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "logFactoryEvent",
            "args": {
              "event_type": "generator_definition_updated",
              "entity_type": "GeneratorDefinition",
              "entity_id": "${ .trigger.entity_id }",
              "severity": "info",
              "workflow_name": "On Generator Definition Updated",
              "payload": {
                "generator_key": "${ .trigger.data.generator_key }",
                "version": "${ .trigger.data.version }"
              }
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Log update",
            "description": "Audit on generator definition update"
          }
        }
      }
    ]
  }
}