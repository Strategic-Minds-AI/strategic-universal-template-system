{
  "name": "RepairTask",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Tenant reference"
    },
    "run_id": {
      "type": "string",
      "title": "GeneratorRun reference"
    },
    "validation_id": {
      "type": "string",
      "title": "RunValidation reference"
    },
    "target_step_key": {
      "type": "string",
      "title": "Step to repair"
    },
    "failing_layer": {
      "type": "string",
      "title": "Classified failing layer"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "applied",
        "verified",
        "failed",
        "cancelled"
      ],
      "default": "open",
      "title": "Repair status"
    },
    "repair_spec": {
      "type": "object",
      "title": "Repair specification (patch target + delta)"
    },
    "attempt": {
      "type": "number",
      "default": 0,
      "title": "Repair attempt"
    },
    "result": {
      "type": "object",
      "title": "Repair result"
    }
  },
  "required": [
    "run_id",
    "target_step_key",
    "status",
    "repair_spec"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": true,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}